define user express greeting
  "hi"
  "hello"
  "hey"

define bot express greeting
  "Hello! I am your AI assistant. How can I help you with the provided documents?"

define user ask out of scope
  "what is the capital of France?"
  "who won the cricket world cup?"
  "tell me a joke"
  "weather today"

define bot refuse out of scope
  "I am strictly restricted to answering questions based solely on the provided ingested documents."

define flow
  user ask out of scope
  bot refuse out of scope